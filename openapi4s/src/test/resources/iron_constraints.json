{
  "openapi": "3.0.0",
  "info": {
    "title": "Iron constraints test",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": ["id", "email", "username", "age", "ratio", "avatar"],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 1000000
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9|@#]+$"
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20,
            "pattern": "^[a-z][a-z0-9|_-]*$"
          },
          "age": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 149
          },
          "score": {
            "type": "number",
            "format": "float",
            "minimum": 0.0,
            "maximum": 10.0
          },
          "ratio": {
            "type": "number",
            "format": "double",
            "minimum": 0.01,
            "maximum": 99.99
          },
          "avatar": {
            "type": "string",
            "format": "byte"
          },
          "nickname": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          },
          "scores": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          "state": {
            "type": "string",
            "enum": ["ACTIVE", "INACTIVE"]
          }
        }
      },
      "Product": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sku": {
            "type": "string",
            "minLength": 3,
            "maxLength": 12
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "weight": {
            "type": "number",
            "format": "float",
            "minimum": 0.5,
            "maximum": 500.0
          }
        }
      }
    }
  }
}
