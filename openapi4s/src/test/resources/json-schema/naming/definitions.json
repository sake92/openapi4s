{
  "title": "Artifact",
  "$defs": {
    "fileNode": {
      "type": "object",
      "required": ["id", "declarationSurface"],
      "properties": {
        "id": { "type": "string" },
        "declarationSurface": { "$ref": "#/$defs/declarationSurface" }
      }
    },
    "declarationSurface": {
      "type": "object",
      "required": ["ports"],
      "properties": { "ports": { "type": "integer" } }
    }
  }
}
