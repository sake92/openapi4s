amends "https://sake92.github.io/deder/config/v0.21.1/DederProject.pkl"

local const publishRepo = if (read?("env:DEDER_PUBLISH_SNAPSHOT") == "true")
  new SonatypeSnapshotRepo { id = "sonatype" }
else
  new SonatypeCentralRepo { id = "sonatype" }

local const baseModule: ScalaModule = new {
  scalaVersion = "2.13.18"
  publish = true
  publishTo = publishRepo
}

local const pomTemplate: PomSettings = new {
  groupId = "ba.sake"
  url = "https://github.com/sake92/openapi4s"
  licenses {
    new PomLicense {
      name = "Apache 2.0 License"
      url = "https://opensource.org/license/apache-2-0"
    }
  }
  developers {
    new PomDeveloper {
      id = "sake92"
      name = "Sakib Hadziavdic"
      email = "sake92@sake.ba"
    }
  }
  scm {
    url = "https://github.com/sake92/openapi4s"
    connection = "scm:git:https://github.com/sake92/openapi4s.git"
  }
}

local const generatorModules = new CreateScalaModules {
  root = "openapi4s"
  layout = "sbt"
  template = (baseModule) {
    deps {
      "ba.sake::regenesca:0.10.1"
      "io.swagger.parser.v3:swagger-parser:2.1.48"
      "org.apache.commons:commons-text:1.15.0"
      "com.typesafe.scala-logging::scala-logging:3.9.6"
    }
    pomSettings = (pomTemplate) {
      artifactId = "openapi4s"
      name = "openapi4s"
      description = "OpenAPI and JSON Schema generator for Scala 3"
    }
  }
  testTemplate = (template.asTest()) {
    // Compilation suites spawn Scala CLI; keep compiler memory bounded.
    maxTestForks = 1
    testParallelism = 1
    deps {
      "org.scalameta::munit:1.3.6"
      "org.slf4j:slf4j-simple:2.0.20"
    }
  }
}.get

local const cliModules = new CreateScalaModules {
  root = "cli"
  layout = "sbt"
  template = (baseModule) {
    moduleDeps { generatorModules.main }
    deps {
      "com.lihaoyi::mainargs:0.7.8"
      "org.slf4j:slf4j-simple:2.0.20"
    }
    mainClass = "ba.sake.openapi4s.cli.OpenApi4sMain"
    pomSettings = (pomTemplate) {
      artifactId = "openapi4s-cli"
      name = "openapi4s-cli"
      description = "OpenAPI4s generator CLI"
    }
  }
  testTemplate = (template.asTest()) {
    deps { "org.scalameta::munit:1.3.6" }
  }
}.get

modules {
  ...generatorModules.all
  ...cliModules.all
}
